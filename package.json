{
  "name": "digi-id-io",
  "private": true,
  "type": "module",
  "description": "digi-id.io website",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/css/app.css -o _site/assets/css/site.css --minify",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run lint:data && vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.14 autorun --config=tests/lighthouserc.json",
    "lint:data": "node scripts/lint-data.mjs",
    "images": "node scripts/generate-images.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.48.0",
    "posthtml": "^0.16.7",
    "posthtml-expressions": "^1.11.4",
    "posthtml-include": "^2.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
